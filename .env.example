# --- LM Studio ---

LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Оставьте пустым, чтобы агент взял первую доступную модель

LM_STUDIO_MODEL=
TEMPERATURE=0.2
MAX_TOKENS=2048

# --- Docker ---

DOCKER_IMAGE=python:3.12-slim
CONTAINER_NAME=lmstudio-sandbox
CONTAINER_WORKSPACE=/workspace

# --- Агент ---

MAX_STEPS=25
EXEC_TIMEOUT=180